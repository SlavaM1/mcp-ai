POSTGRES_DB=mcp_ai
POSTGRES_USER=mcp_ai
POSTGRES_PASSWORD=mcp_ai_local
DATABASE_URL=postgresql+psycopg://mcp_ai:mcp_ai_local@db:5432/mcp_ai
MCP_SERVER_URL=http://weather-mcp:8001/mcp
MCP_SERVERS={"weather":"http://weather-mcp:8001/mcp","currency":"http://currency-mcp:8002/mcp","travel":"http://travel-mcp:8003/mcp","report":"http://report-mcp:8004/mcp"}
MCP_TIMEOUT_SECONDS=30
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# Choose deepseek-chat or deepseek-reasoner. deepseek-chat is recommended for tool calling.
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
MAX_TOOL_CALLS=12
CORS_ORIGINS=http://localhost:4201
FRONTEND_PORT=4201
BACKEND_PORT=8000
WEATHER_MCP_PORT=8001
CURRENCY_MCP_PORT=8002
TRAVEL_MCP_PORT=8003
REPORT_MCP_PORT=8004
# SQLite scheduler data and Markdown reports are persisted under /data in mcp-ai-weather-mcp-data.
WEATHER_BASE_URL=https://wttr.in
WEATHER_HTTP_TIMEOUT_SECONDS=15
WEATHER_REPORTS_DIRECTORY=/data/reports
CURRENCY_BASE_URL=https://open.er-api.com/v6/latest
CURRENCY_HTTP_TIMEOUT_SECONDS=10
# Markdown reports are persisted in mcp-ai-report-mcp-reports.
# HTTP_PROXY=http://proxy.example:3128
# HTTPS_PROXY=http://proxy.example:3128
NO_PROXY=db,backend,frontend,weather-mcp,currency-mcp,travel-mcp,report-mcp,localhost,127.0.0.1
